<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.humainary.testkit</groupId>
  <artifactId>humainary-serventis-api-tck</artifactId>
  <version>3.1.2</version>

  <name>Humainary Serventis Java API TCK</name>
  <description>Technology Compatibility Kit for the Humainary Serventis Java API.</description>
  <url>https://github.com/humainary-io/serventis-api-java-tck</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <scm>
    <connection>scm:git:https://github.com/humainary-io/serventis-api-java-tck.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/humainary-io/serventis-api-java-tck.git
    </developerConnection>
    <url>https://github.com/humainary-io/serventis-api-java-tck</url>
  </scm>

  <properties>
    <specs.api.version>3.1.2</specs.api.version>
    <serventis.api.version>3.1.2</serventis.api.version>
    <substrates.api.version>3.1.2</substrates.api.version>
    <substrates.tck.version>3.1.2</substrates.tck.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <java.version>26</java.version>
    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.6.0-M1</maven-surefire-plugin.version>
    <junit.version>6.1.0</junit.version>
    <tck.test.timeout>2 m</tck.test.timeout>
    <tck.fork.timeout.seconds>1800</tck.fork.timeout.seconds>

  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <release>${java.version}</release>
          <debug>false</debug>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <configuration>
          <forkedProcessTimeoutInSeconds>${tck.fork.timeout.seconds}</forkedProcessTimeoutInSeconds>
          <forkedProcessExitTimeoutInSeconds>30</forkedProcessExitTimeoutInSeconds>
          <systemPropertyVariables>
            <junit.jupiter.execution.timeout.default>${tck.test.timeout}
            </junit.jupiter.execution.timeout.default>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>

    <dependency>
      <groupId>io.humainary.specs</groupId>
      <artifactId>humainary-specs-api</artifactId>
      <version>${specs.api.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.humainary.substrates</groupId>
      <artifactId>humainary-substrates-api</artifactId>
      <version>${substrates.api.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.humainary.testkit</groupId>
      <artifactId>humainary-substrates-api-tck</artifactId>
      <version>${substrates.tck.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.humainary.serventis</groupId>
      <artifactId>humainary-serventis-api</artifactId>
      <version>${serventis.api.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <id>spi-provider</id>
      <activation>
        <property>
          <name>substrates.spi.artifactId</name>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>${substrates.spi.groupId}</groupId>
          <artifactId>${substrates.spi.artifactId}</artifactId>
          <version>${substrates.spi.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>

</project>
